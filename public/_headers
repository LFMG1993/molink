# Set the correct MIME type for TypeScript files served as modules
/src/*.ts
  Content-Type: application/javascript; charset=utf-8

# Best practices for other assets generated by Vite
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Ensure correct MIME types for fonts and CSS, just in case
*.css
  Content-Type: text/css; charset=utf-8
*.woff2
  Content-Type: font/woff2